# ==================================================================
# CN Project - backend isolation (Extension C)
#
# Generated by scripts/render.sh. Loaded by firewall/firewall.sh into
# the pf anchor "com.apple/cn-project", so /etc/pf.conf is never
# edited and rollback is a single flush of this anchor.
#
# Policy on the backend Macs (Mac 3, Mac 4):
#   * TCP 3001/3002 is accepted ONLY from the edge(s) in <edges>
#   * everyone else is silently dropped (client sees a timeout)
#   * every other port (ping, SSH, DNS on 53, ...) is untouched
#
# pf evaluates rules top to bottom; "quick" stops at the first match.
# ==================================================================

# Machines allowed to talk to the backends. Starts with the primary
# edge only; the standby edge is added during Extension E with
#   ./firewall/firewall.sh allow-standby
table <edges> persist { @EDGE_IP@ }

# 1. Local traffic (a Mac talking to itself) is always fine.
pass in quick on lo0 all no state

# 2. The edge may open connections to the backend ports.
pass in quick proto tcp from <edges> to any port { 3001 3002 } flags S/SA keep state

# 3. Anyone else trying those ports: drop, and log it (pflog0).
block drop in log quick proto tcp from any to any port { 3001 3002 }
