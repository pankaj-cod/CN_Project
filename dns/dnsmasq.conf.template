# ==================================================================
# CN Project - dnsmasq config (Phase 2)          ROLE: @ROLE@
#
# Generated by scripts/render.sh from dns/dnsmasq.conf.template.
# The PRIMARY (Mac 1) and the BACKUP (Extension A) are rendered from
# the same template, so both always serve identical records.
#
# Install on the DNS Mac with:   ./dns/dns.sh install @ROLE_LC@
# ==================================================================

port=53

# Listen on the LAN interface (other Macs must reach us) and loopback.
interface=@DNS_IFACE@
listen-address=127.0.0.1,@LISTEN_IP@
bind-interfaces

# Never forward plain names or private reverse lookups upstream.
domain-needed
bogus-priv

# Where non-team names (google.com, ...) are forwarded. Do NOT read
# /etc/resolv.conf: once this Mac is pointed at the team DNS, that file
# lists Mac 1 / the backup, and the two DNS servers would forward to
# each other in a loop. "./dns/dns.sh install" appends the server= lines
# below with this Mac's DHCP DNS (or UPSTREAM_DNS from team.env).
no-resolv

# We are authoritative for @TEAM@.test: unknown names under it get
# NXDOMAIN locally and are never sent to the internet.
local=/@TEAM@.test/

# ------------------------------------------------------------------
# Project records (Extension B).
# host-record=<name>,<IPv4>,<TTL>
#   Phase 1 used address=/name/IP, which dnsmasq answers with TTL 0
#   (clients never cache).  host-record lets us set an explicit TTL
#   so caching and cutover behaviour is visible.
#
# Change a record with:  ./dns/dns.sh set app <new-ip>
# (run it on BOTH the primary and the backup DNS Mac)
# ------------------------------------------------------------------
host-record=app.@TEAM@.test,@EDGE_IP@,@DNS_TTL@
host-record=api.@TEAM@.test,@EDGE_IP@,@DNS_TTL@

# Per-machine names - handy for diagnosis (ping mac3.@TEAM@.test).
host-record=dns1.@TEAM@.test,@MAC1_IP@,@DNS_TTL@
host-record=dns2.@TEAM@.test,@BACKUP_DNS_IP@,@DNS_TTL@
host-record=edge.@TEAM@.test,@EDGE_IP@,@DNS_TTL@
host-record=standby-edge.@TEAM@.test,@STANDBY_EDGE_IP@,@DNS_TTL@

# Evidence: log every query (who asked, what, what we answered).
log-queries
log-facility=@BREW_PREFIX@/var/log/dnsmasq-cn.log
