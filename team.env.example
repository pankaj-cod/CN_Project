# ------------------------------------------------------------------
# Team network inventory (Phase 2)
#
#   cp team.env.example team.env     # team.env is git-ignored
#   edit team.env with your real LAN IPs
#   ./scripts/render.sh              # writes ready-to-use configs to build/
#
# Every script in scripts/, dns/ and firewall/ reads this file, so the
# IPs only have to be typed once.
# ------------------------------------------------------------------

# Private domain is app.$TEAM.test / api.$TEAM.test
TEAM=teamX

# Mac 1 - primary DNS (dnsmasq) + test client
MAC1_IP=192.168.1.11

# Mac 2 - primary edge (nginx: TLS termination + load balancer)
EDGE_IP=192.168.1.12

# Mac 3 - Backend A (port 3001)          + BACKUP DNS (Extension A)
BACKEND_A_IP=192.168.1.13

# Mac 4 - Backend B (port 3002) + client + STANDBY EDGE (Extension E)
BACKEND_B_IP=192.168.1.14

# Which Mac runs the backup dnsmasq (must NOT be Mac 1). Default: Mac 3.
BACKUP_DNS_IP=192.168.1.13

# Which Mac runs the standby nginx for the DNS cutover. Default: Mac 4.
STANDBY_EDGE_IP=192.168.1.14

# TTL (seconds) put on app/api records - short so TTL effects are visible.
DNS_TTL=30

# Network interface dnsmasq listens on (check with: route get default)
DNS_IFACE=en0

# macOS network service name used by networksetup (Wi-Fi or Ethernet)
NET_SERVICE=Wi-Fi

# Optional: where the team DNS forwards non-team names (google.com ...).
# Empty = the DHCP DNS of the DNS Mac (+ 1.1.1.1 as fallback). Set it if
# the campus DNS should be used explicitly, e.g. UPSTREAM_DNS=10.0.0.1
UPSTREAM_DNS=
