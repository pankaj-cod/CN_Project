# ==================================================================
# CN Project - nginx edge config (Phase 2)        EDGE: @EDGE_NAME@
#
# Generated by scripts/render.sh from nginx/nginx-phase2.conf.template.
# The primary edge (Mac 2) and the standby edge (Extension E) are
# rendered from the same template; only X-Edge differs, so every
# response shows which edge handled it.
#
# Changes vs Phase 1 (nginx/nginx.conf):
#   * X-Edge header         -> which edge served the request (Ext. E)
#   * X-Upstream header     -> which backend(s) nginx tried   (Ext. D)
#   * proxy_next_upstream_tries / timeouts tuned for fast failover
#   * access log with upstream address/status per request (evidence)
#   * /edge-health          -> answers from nginx itself, no backend
# ==================================================================

worker_processes 1;

events {
    worker_connections 1024;
}

http {
    include mime.types;
    default_type application/octet-stream;

    sendfile on;
    keepalive_timeout 65;

    # One line per request: client, host, status, and every upstream
    # nginx tried with its status. A failover shows up as e.g.
    #   upstream="10.0.0.13:3001, 10.0.0.14:3002" ustatus="502, 200"
    log_format edge '$remote_addr [$time_local] "$host" "$request" $status '
                    'edge=@EDGE_NAME@ upstream="$upstream_addr" '
                    'ustatus="$upstream_status" urt="$upstream_response_time"';
    access_log @BREW_PREFIX@/var/log/nginx/cn-edge-access.log edge;

    # ==============================================================
    # Backend pool - round-robin with PASSIVE health checks (Ext. D)
    #
    # Open-source nginx has no active health probes. Instead:
    #   max_fails=1     one failed connect/timeout marks the server down
    #   fail_timeout=5s it stays out of rotation for 5 s, then nginx
    #                   sends it one real request to see if it is back
    # Together with proxy_next_upstream (below) the request that hit the
    # dead backend is retried on the healthy one, so the client never
    # sees the failure.
    # ==============================================================
    upstream backend_servers {
        server @BACKEND_A_IP@:3001 max_fails=1 fail_timeout=5s;
        server @BACKEND_B_IP@:3002 max_fails=1 fail_timeout=5s;
    }

    # HTTP -> HTTPS
    server {
        listen 80;
        server_name app.@TEAM@.test api.@TEAM@.test;
        return 301 https://$host$request_uri;
    }

    # HTTPS: TLS termination + reverse proxy
    server {
        listen 443 ssl;
        server_name app.@TEAM@.test api.@TEAM@.test;

        ssl_certificate     certs/@TEAM@.crt;
        ssl_certificate_key certs/@TEAM@.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;

        # Which edge answered (primary / standby) and which backend
        # address(es) were used. "always" = also on 502/504 errors.
        add_header X-Edge     "@EDGE_NAME@"   always;
        add_header X-Upstream $upstream_addr  always;

        # Edge liveness, answered by nginx alone. If this works but /
        # returns 502, the edge is fine and the backends are the problem.
        location = /edge-health {
            access_log off;
            default_type application/json;
            return 200 '{"edge":"@EDGE_NAME@","status":"ok"}\n';
        }

        location / {
            proxy_pass http://backend_servers;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Failover: on a connect error / timeout / 5xx, retry the
            # request on the next backend - at most 2 tries in 5 s.
            proxy_next_upstream         error timeout http_502 http_503 http_504;
            proxy_next_upstream_tries   2;
            proxy_next_upstream_timeout 5s;

            # A firewalled or powered-off backend drops packets instead
            # of refusing - fail fast rather than hang the client.
            proxy_connect_timeout 2s;
            proxy_read_timeout    5s;
        }
    }
}
